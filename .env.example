# ───────────────────────── Browser (public) ─────────────────────────
# Safe to expose. Found in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: Cloudflare Turnstile site key (spam protection on public forms).
VITE_TURNSTILE_SITE_KEY=

# ───────────────────────── Server only (Netlify functions) ─────────────────────────
# NEVER prefix these with VITE_. Set them in Netlify → Site configuration → Environment variables.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Public URL of the deployed site, used to build tracking links.
SITE_URL=https://your-site.netlify.app
# Random string (32+ chars) used to hash visitor IPs for rate limiting.
IP_HASH_SALT=change-me-to-a-long-random-string

# Optional: transactional email through Resend (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM=DevMart <orders@your-domain.com>
ADMIN_NOTIFY_EMAIL=
# Optional: Cloudflare Turnstile secret key (must pair with VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=
